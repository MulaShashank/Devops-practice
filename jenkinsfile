pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                dir('ci-node-app') {
                    sh 'npm ci'
                }
            }
        }

        stage('Test') {
            steps {
                dir('ci-node-app') {
                    sh 'npm test'
                }
            }
        }

        stage('Build') {
            steps {
                dir('ci-node-app') {
                    sh 'npm run build'
                }
            }
        }
    }
}
